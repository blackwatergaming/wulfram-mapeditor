{
  "name": "wulfram-mapeditor",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types tools/dev.mjs",
    "dev:editor": "vinext dev",
    "build": "vinext build",
    "build:desktop-web": "vite build --config vite.desktop.config.ts",
    "build:desktop": "node tools/build-desktop.mjs",
    "desktop:assets": "node tools/create-desktop-assets.mjs",
    "measure:desktop": "node tools/measure-webview.mjs 9223 outputs/webview-measurement.png",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/base-layout.test.mjs tests/base-template.test.mjs tests/camera-controls.test.mjs tests/heightmap.test.mjs tests/map-repository.test.mjs tests/model-transform.test.mjs tests/og-map-roundtrip.test.mjs tests/skybox.test.mjs tests/terrain-blend.test.mjs tests/terrain-brush.test.mjs tests/terrain-textures.test.mjs tests/unit-material.test.mjs",
    "test:og-maps": "node --experimental-strip-types --test tests/og-map-roundtrip.test.mjs",
    "verify:formats": "node --experimental-strip-types tools/verify-formats.mjs",
    "maps:list": "node --experimental-strip-types tools/maps-cli.mjs list",
    "maps:import": "node --experimental-strip-types tools/maps-cli.mjs import",
    "maps:seed-original": "node --experimental-strip-types tools/maps-cli.mjs seed-original",
    "maps:compile": "node --experimental-strip-types tools/maps-cli.mjs compile",
    "maps:doctor": "node --experimental-strip-types tools/maps-cli.mjs doctor",
    "maps:branch": "node --experimental-strip-types tools/maps-cli.mjs branch",
    "maps:publish": "node --experimental-strip-types tools/maps-cli.mjs publish",
    "maps:release": "node --experimental-strip-types tools/maps-cli.mjs release",
    "maps:serve": "node --experimental-strip-types tools/maps-repository-server.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
